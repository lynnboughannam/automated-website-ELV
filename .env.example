# Shared secret: the CRM sends it to this app (header x-webhook-secret or ?secret=),
# and this app sends it back to the CRM on every callback (header x-webhook-secret)
CAROUSEL_WEBHOOK_SECRET=change-me-long-random-string
# Vercel Blob read/write token (added automatically when you connect a Blob store in Vercel)
BLOB_READ_WRITE_TOKEN=
# CRM endpoint (Lovable Cloud) that receives the render result
CRM_CALLBACK_URL=https://YOUR-CRM.example.com/functions/v1/carousel-callback
# Local dev only: path to your installed Chrome
# CHROME_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
